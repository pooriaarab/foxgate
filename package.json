{
  "name": "foxgate",
  "version": "0.1.6",
  "description": "TypeScript policy library for AI agent tool authorization, exact-action approvals, domain grants, and spend caps in Node.js and Firefox.",
  "type": "module",
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/foxgate.git"
  },
  "homepage": "https://github.com/pooriaarab/foxgate#readme",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run --passWithNoTests",
    "ci:local": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm build:ext && pnpm lint:ext && pnpm check:amo",
    "build:ext": "node scripts/build-ext.mjs",
    "lint:ext": "web-ext lint -s dist-ext --warnings-as-errors",
    "check:amo": "node scripts/amo-listing.mjs check",
    "e2e": "node scripts/build-ext.mjs --e2e && node e2e/run.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "create-foxkit": "^0.1.2",
    "esbuild": "^0.28.2",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "web-ext": "^10.7.0"
  },
  "keywords": [
    "TypeScript",
    "Node.js",
    "Firefox",
    "WebExtensions",
    "Web Crypto",
    "ai-agents",
    "authorization",
    "policy",
    "approvals",
    "spend-caps",
    "domain-grants",
    "human-in-the-loop"
  ]
}
